# Environment for the test suite. Because phpunit.xml sets APP_ENV=testing,
# Laravel loads this file instead of .env, so tests never pick up local
# settings or credentials (Microsoft 365 app, MaxMind key, report address).
# phpunit.xml still sets the database, cache, queue and mail drivers.
# The key below is for tests only; never use it for a real installation.

APP_NAME="DMARC Monitor"
APP_ENV=testing
APP_KEY=base64:1Uz3w/WkfH2hM7OX0/cPH7GiFYGqVYsltEMbDJHpBK4=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

FILESYSTEM_DISK=local

MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
