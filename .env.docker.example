# Environment for the container. Copy to `.env.docker` next to the compose file: compose
# passes every variable in it to the container as an environment variable
# (there is no .env file inside the image). Variables that are commented out show
# the default. See the README for a description of each one.

# --- Required -----------------------------------------------------------------
# Generate with: docker run --rm <image> php artisan key:generate --show
APP_KEY=
# Public URL of the app (used in links and emails).
APP_URL=https://dmarc.example.com

# --- Application ---------------------------------------------------------------
APP_NAME="DMARC Monitor"
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=en
# APP_FALLBACK_LOCALE=en
# Old APP_KEY values (comma-separated) still accepted while rotating the key.
# APP_PREVIOUS_KEYS=
# APP_MAINTENANCE_DRIVER=file
# BCRYPT_ROUNDS=12

# --- Container -----------------------------------------------------------------
# Run `migrate --force` on start (web and all-in-one roles). Set to false on any
# additional replica.
RUN_MIGRATIONS=true
# Behind a TLS-terminating reverse proxy set this to the proxy's address(es),
# comma-separated, or * to trust any (only when the container is not directly exposed).
# TRUSTED_PROXIES=*
# Host port of the smtp service in compose.split.yaml (compose variable only).
# DMARC_SMTP_PUBLISHED_PORT=2525

# --- Database ------------------------------------------------------------------
# Default: SQLite inside the persisted /app/storage volume (single container only).
DB_CONNECTION=sqlite
# DB_DATABASE=/app/storage/database/database.sqlite

# MySQL / MariaDB (mysql, mariadb; see compose.split.yaml) or PostgreSQL (pgsql):
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=dmarc
# DB_USERNAME=dmarc
# DB_PASSWORD=change-me
# DB_URL=
# DB_SOCKET=
# DB_SSLMODE=prefer
# MYSQL_ATTR_SSL_CA=

# --- Session, cache and queue --------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# SESSION_ENCRYPT=false
# Only sent back over HTTPS. Leave this true unless the app is genuinely served over
# plain HTTP (it normally sits behind a TLS-terminating reverse proxy).
SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=
CACHE_STORE=database
# CACHE_PREFIX=
# The scheduler drains the queue every five minutes; no separate worker is needed.
QUEUE_CONNECTION=database

# --- Redis (only when used for cache, session or queue) ------------------------
# REDIS_CLIENT=phpredis
# REDIS_URL=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_CACHE_DB=1

# --- Logging -------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=info
# LOG_STACK=single
# LOG_DAILY_DAYS=14

# --- Outgoing mail (alert emails) ---------------------------------------------
# Set to "microsoft365" to send via Microsoft Graph using the account
# configured under Settings > Microsoft 365 Sending Account.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="dmarc@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=null
# MAIL_EHLO_DOMAIN=

# --- Report data ---------------------------------------------------------------
# Days of report data, resolved alert events, trashed domains and audit logs to keep.
DATA_RETENTION_DAYS=400

# MaxMind GeoLite2 ASN/country enrichment (optional; reverse DNS works without it).
# The databases are downloaded weekly into the storage volume.
MAXMIND_LICENSE_KEY=
# MAXMIND_ASN_DB_PATH=/app/storage/app/geoip/GeoLite2-ASN.mmdb
# MAXMIND_COUNTRY_DB_PATH=/app/storage/app/geoip/GeoLite2-Country.mmdb
# GEOIP_CACHE_DAYS=30

# Local .eml/.msg import: drop files into <DMARC_EML_IMPORT_PATH>/inbox. The default
# lives in the storage volume; mount a host folder there to feed it from outside.
# DMARC_EML_IMPORT_PATH=/app/storage/app/dmarc-eml

# --- Built-in SMTP listener ----------------------------------------------------
# The listener only starts when this is true (port 2525 in the container), both in
# the all-in-one container and in the `smtp` service of compose.split.yaml.
DMARC_SMTP_ENABLED=false
# Client addresses allowed to connect: IPs/CIDRs, comma-separated, or spf:<domain>
# to follow a provider's SPF ranges. Empty = loopback only, i.e. nobody from outside
# the container, so this must be set. Inside Docker the source address is usually
# the Docker network gateway or your reverse proxy / relay.
# DMARC_SMTP_ALLOWED_IPS=spf:spf.protection.outlook.com
# DMARC_SMTP_HOST=0.0.0.0
# DMARC_SMTP_PORT=2525
# DMARC_SMTP_MAX_MESSAGE_BYTES=26214400
# DMARC_SMTP_IDLE_TIMEOUT=60
# DMARC_SMTP_MAX_CONNECTIONS=20
# Optional STARTTLS: mount a PEM certificate (and key) into the container.
# DMARC_SMTP_TLS_CERT=/certs/smtp.pem
# DMARC_SMTP_TLS_KEY=/certs/smtp.key
# DMARC_SMTP_TLS_PASSPHRASE=
# DMARC_SMTP_TLS_REQUIRED=false
